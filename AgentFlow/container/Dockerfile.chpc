FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/scratch/hf_cache

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-dev \
    python3-pip \
    python3.11-venv \
    build-essential \
    git \
    curl \
    wget \
    ca-certificates \
    ninja-build \
    pkg-config \
    libglib2.0-0 \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

RUN python3.11 -m pip install --upgrade pip==24.3.1 setuptools==75.8.0 wheel==0.45.1

WORKDIR /workspace/transschema
COPY . /workspace/transschema

RUN python3.11 -m pip install packaging==25.0 ninja==1.11.1.1 numpy==1.26.4

RUN python3.11 -m pip install \
    torch==2.7.0 torchvision==0.22.0 torchaudio==2.7.0 \
    --index-url https://download.pytorch.org/whl/cu128

RUN python3.11 -m pip install \
    pyvers==0.1.0 \
    tensordict==0.9.1 \
    accelerate \
    codetiming \
    hydra-core \
    peft \
    pybind11 \
    pylatexenc \
    wandb \
    torchdata \
    "ray[default]==2.43.0"

RUN python3.11 -m pip install vllm==0.9.2 --no-deps
RUN python3.11 -m pip install \
    blake3 \
    cachetools \
    compressed-tensors==0.10.2 \
    depyf==0.18.0 \
    einops \
    "gguf>=0.13.0" \
    lark==1.2.2 \
    "lm-format-enforcer>=0.10.11,<0.11" \
    "mistral_common[opencv]>=1.6.2" \
    msgspec \
    numba==0.61.2 \
    "opencv-python-headless>=4.11.0" \
    outlines==0.1.11 \
    partial-json-parser \
    "prometheus_client>=0.18.0" \
    prometheus-fastapi-instrumentator \
    py-cpuinfo \
    pybase64 \
    python-json-logger \
    "pyzmq>=25.0.0" \
    scipy \
    sentencepiece \
    watchfiles \
    xgrammar==0.1.19 \
    "openai>=1.52.0,<=1.90.0" \
    "fastapi[standard]>=0.115.0,<0.116" \
    llguidance==0.7.30

RUN python3.11 -m pip install verl==0.5.0 --no-deps

RUN python3.11 -m pip install -r /workspace/transschema/AgentFlow/agentflow/requirements.txt
RUN python3.11 -m pip install \
    flask \
    requests \
    omegaconf \
    tqdm \
    datasets==4.3.0 \
    pyarrow==21.0.0 \
    pandas==2.1.4 \
    filelock==3.19.1 \
    pyyaml==6.0.2 \
    python-Levenshtein==0.26.0 \
    scikit-learn==1.5.1 \
    psycopg2-binary==2.9.10

# Build real flash-attn inside the container with proper CUDA toolchain and Python headers.
ENV CUDA_HOME=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:${PATH} \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH} \
    FLASH_ATTENTION_FORCE_BUILD=TRUE \
    MAX_JOBS=8

RUN python3.11 -m pip install flash-attn==2.7.4.post1 --no-build-isolation --no-cache-dir

RUN python3.11 -m pip install --force-reinstall transformers==4.53.3 tokenizers==0.21.4 openai==1.75.0 dashscope==1.24.2

RUN python3.11 -m pip install -e /workspace/transschema/AgentFlow/agentflow --no-deps

WORKDIR /workspace/transschema/AgentFlow

CMD ["bash"]
