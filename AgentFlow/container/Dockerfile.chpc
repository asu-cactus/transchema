FROM nvcr.io/nvidia/pytorch:25.02-py3

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/scratch/hf_cache \
    CUDA_HOME=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:${PATH} \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH} \
    TORCH_CUDA_ARCH_LIST="12.0+PTX" \
    VLLM_TARGET_DEVICE=cuda \
    MAX_JOBS=8 \
    CMAKE_BUILD_PARALLEL_LEVEL=8

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    curl \
    wget \
    ca-certificates \
    ninja-build \
    pkg-config \
    libnuma-dev \
    libglib2.0-0 \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/transschema
COPY . /workspace/transschema

RUN PYTHON_BIN="$(command -v python || command -v python3)" && \
    "${PYTHON_BIN}" -m pip install --upgrade \
      pip==24.3.1 \
      setuptools==75.8.0 \
      wheel==0.45.1 && \
    "${PYTHON_BIN}" -m pip install \
      packaging==25.0 \
      ninja==1.11.1.1 \
      numpy==1.26.4 \
      "setuptools_scm<8" \
      "cmake>=3.26,<4"

RUN PYTHON_BIN="$(command -v python || command -v python3)" && \
    "${PYTHON_BIN}" -m pip install \
      pyvers==0.1.0 \
      tensordict==0.9.1 \
      accelerate \
      codetiming \
      hydra-core \
      peft \
      pybind11 \
      pylatexenc \
      wandb \
      torchdata \
      "ray[default]==2.43.0"

RUN PYTHON_BIN="$(command -v python || command -v python3)" && \
    "${PYTHON_BIN}" -m pip install \
      blake3 \
      cachetools \
      compressed-tensors==0.10.2 \
      depyf==0.18.0 \
      einops \
      "gguf>=0.13.0" \
      lark==1.2.2 \
      "lm-format-enforcer>=0.10.11,<0.11" \
      "mistral_common[opencv]>=1.6.2" \
      msgspec \
      numba==0.61.2 \
      "opencv-python-headless>=4.11.0" \
      outlines==0.1.11 \
      partial-json-parser \
      "prometheus_client>=0.18.0" \
      prometheus-fastapi-instrumentator \
      py-cpuinfo \
      pybase64 \
      python-json-logger \
      "pyzmq>=25.0.0" \
      scipy \
      sentencepiece \
      watchfiles \
      xgrammar==0.1.19 \
      "openai>=1.52.0,<=1.90.0" \
      "fastapi[standard]>=0.115.0,<0.116" \
      llguidance==0.7.30

# xformers@main requires torch/csrc/stable/ headers absent in the NGC 25.02 torch nightly
# (2.7.0a0).  vllm 0.9.2 uses Triton/flash-attn kernels and does not require xformers.

RUN PYTHON_BIN="$(command -v python || command -v python3)" && \
    "${PYTHON_BIN}" -m pip install --force-reinstall --no-deps \
      setuptools==75.8.0 wheel==0.45.1 "setuptools_scm<8" && \
    rm -rf /tmp/vllm-src && \
    git clone --branch v0.9.2 --depth 1 https://github.com/vllm-project/vllm.git /tmp/vllm-src && \
    "${PYTHON_BIN}" -c "
import re, pathlib
# Patch 1: fix pyproject.toml license fields.
p = pathlib.Path('/tmp/vllm-src/pyproject.toml')
t = p.read_text()
t = t.replace('license = \"Apache-2.0\"', 'license = { text = \"Apache-2.0\" }')
t = '\n'.join(l for l in t.splitlines() if 'license-files' not in l)
p.write_text(t + '\n')
# Patch 2: replace PEP 585 lowercase generics with typing.* forms.
# torch.library.infer_schema in NGC 25.02 torch nightly only accepts typing.* forms.
SUBS = [(r'\blist\[','List['),(r'\bdict\[','Dict['),(r'\btuple\[','Tuple['),(r'\bset\[','Set[')]
NAMES = {'List','Dict','Tuple','Set'}
for f in pathlib.Path('/tmp/vllm-src').rglob('*.py'):
    try: orig = f.read_text(encoding='utf-8')
    except: continue
    new = orig
    for pat, rep in SUBS: new = re.sub(pat, rep, new)
    if new == orig: continue
    need = sorted(n for n in NAMES if re.search(r'\b'+n+r'\[',new) and not re.search(r'\b'+n+r'\b',orig))
    if need:
        imp = 'from typing import ' + ', '.join(need)
        lines = new.split('\n')
        pos = 0
        for i,l in enumerate(lines):
            if l.strip().startswith('from __future__ import'): pos = i+1
        lines.insert(pos, imp)
        new = '\n'.join(lines)
    f.write_text(new, encoding='utf-8')
print('vllm PEP585 patch done')
" && \
    "${PYTHON_BIN}" -m pip install --no-build-isolation --no-cache-dir --no-deps /tmp/vllm-src && \
    rm -rf /tmp/vllm-src

RUN PYTHON_BIN="$(command -v python || command -v python3)" && \
    "${PYTHON_BIN}" -m pip install verl==0.5.0 --no-deps

RUN PYTHON_BIN="$(command -v python || command -v python3)" && \
    "${PYTHON_BIN}" -m pip install \
      aiohttp==3.10.4 \
      anthropic==0.40.0 \
      openai==1.75.0 \
      together==1.5.4 \
      google-genai \
      diskcache==5.6.3 \
      easyocr==1.7.2 \
      metapub==0.5.12 \
      pillow==11.1.0 \
      platformdirs==4.3.6 \
      pymed==0.8.9 \
      python-dotenv==1.0.1 \
      setproctitle==1.3.4 \
      sympy==1.13.1 \
      tenacity==9.0.0 \
      wikipedia==1.4.0 \
      dashscope==1.24.2 \
      requests \
      flask \
      omegaconf \
      tqdm \
      datasets==4.3.0 \
      pyarrow==21.0.0 \
      pandas==2.1.4 \
      filelock==3.19.1 \
      pyyaml==6.0.2 \
      python-Levenshtein==0.26.0 \
      scikit-learn==1.5.1 \
      opentelemetry-api==1.29.0 \
      opentelemetry-sdk==1.29.0 \
      opentelemetry-exporter-otlp-proto-http==1.29.0 \
      opentelemetry-exporter-otlp-proto-grpc==1.29.0 \
      opentelemetry-semantic-conventions==0.50b0 \
      psycopg2-binary==2.9.10

RUN PYTHON_BIN="$(command -v python || command -v python3)" && \
    FLASH_ATTENTION_SKIP_CUDA_BUILD=TRUE \
    FLASH_ATTENTION_FORCE_BUILD=FALSE \
    "${PYTHON_BIN}" -m pip install --no-build-isolation --no-cache-dir --no-deps \
      flash-attn==2.7.4.post1

RUN PYTHON_BIN="$(command -v python || command -v python3)" && \
    "${PYTHON_BIN}" -m pip install --force-reinstall \
      transformers==4.53.3 \
      tokenizers==0.21.4 \
      openai==1.75.0 \
      dashscope==1.24.2

RUN PYTHON_BIN="$(command -v python || command -v python3)" && \
    "${PYTHON_BIN}" -m pip install --force-reinstall --no-deps --no-cache-dir \
      numpy==1.26.4 \
      pyarrow==21.0.0 \
      pandas==2.1.4

# The NGC 25.02 torch nightly (2.7.0a0, Feb 2025) was built against Triton 3.2.x,
# which still exposes AttrsDescriptor.  Triton 3.3.0 removed AttrsDescriptor from
# its public API, breaking torch.compile / TorchInductor.  Pin triton last so no
# earlier install can upgrade it past 3.2.
RUN PYTHON_BIN="$(command -v python || command -v python3)" && \
    "${PYTHON_BIN}" -m pip install --force-reinstall --no-deps --no-cache-dir \
      triton==3.2.0

WORKDIR /workspace/transschema/AgentFlow

CMD ["bash"]
