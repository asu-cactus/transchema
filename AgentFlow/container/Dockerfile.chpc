FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/scratch/hf_cache

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-dev \
    python3-pip \
    python3.11-venv \
    build-essential \
    cmake \
    git \
    curl \
    wget \
    ca-certificates \
    ninja-build \
    pkg-config \
    libnuma-dev \
    libglib2.0-0 \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

RUN python3.11 -m pip install --upgrade pip==24.3.1 setuptools==75.8.0 wheel==0.45.1

WORKDIR /workspace/transschema
COPY . /workspace/transschema

RUN python3.11 -m pip install packaging==25.0 ninja==1.11.1.1 numpy==1.26.4

ENV CUDA_HOME=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:${PATH} \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH} \
    TORCH_CUDA_ARCH_LIST="12.0+PTX" \
    FLASH_ATTENTION_FORCE_BUILD=TRUE \
    VLLM_TARGET_DEVICE=cuda \
    MAX_JOBS=8 \
    CMAKE_BUILD_PARALLEL_LEVEL=8

RUN python3.11 -m pip install --pre \
    torch torchvision torchaudio \
    --index-url https://download.pytorch.org/whl/nightly/cu128

RUN python3.11 -m pip install \
    pyvers==0.1.0 \
    tensordict==0.9.1 \
    accelerate \
    codetiming \
    hydra-core \
    peft \
    pybind11 \
    pylatexenc \
    wandb \
    torchdata \
    "ray[default]==2.43.0"

# xformers wheels lag Blackwell support; compile from source against the active torch.
RUN python3.11 -m pip install --no-build-isolation --no-cache-dir --upgrade \
    "git+https://github.com/facebookresearch/xformers.git@main#egg=xformers"

# Build the vLLM release used by this project from source so the extension
# modules are compiled for sm_120 instead of relying on the generic wheel.
RUN python3.11 -m pip install --no-build-isolation --no-cache-dir --upgrade \
    "git+https://github.com/vllm-project/vllm.git@v0.9.2#egg=vllm"
RUN python3.11 -m pip install \
    blake3 \
    cachetools \
    compressed-tensors==0.10.2 \
    depyf==0.18.0 \
    einops \
    "gguf>=0.13.0" \
    lark==1.2.2 \
    "lm-format-enforcer>=0.10.11,<0.11" \
    "mistral_common[opencv]>=1.6.2" \
    msgspec \
    numba==0.61.2 \
    "opencv-python-headless>=4.11.0" \
    outlines==0.1.11 \
    partial-json-parser \
    "prometheus_client>=0.18.0" \
    prometheus-fastapi-instrumentator \
    py-cpuinfo \
    pybase64 \
    python-json-logger \
    "pyzmq>=25.0.0" \
    scipy \
    sentencepiece \
    watchfiles \
    xgrammar==0.1.19 \
    "openai>=1.52.0,<=1.90.0" \
    "fastapi[standard]>=0.115.0,<0.116" \
    llguidance==0.7.30

RUN python3.11 -m pip install verl==0.5.0 --no-deps

RUN python3.11 -m pip install -r /workspace/transschema/AgentFlow/agentflow/requirements.txt
RUN python3.11 -m pip install \
    flask \
    requests \
    omegaconf \
    tqdm \
    datasets==4.3.0 \
    pyarrow==21.0.0 \
    pandas==2.1.4 \
    filelock==3.19.1 \
    pyyaml==6.0.2 \
    python-Levenshtein==0.26.0 \
    scikit-learn==1.5.1 \
    psycopg2-binary==2.9.10

# Build flash-attn from source; older wheel pins predate Blackwell support.
RUN python3.11 -m pip install --no-build-isolation --no-cache-dir --upgrade \
    "git+https://github.com/Dao-AILab/flash-attention.git@main#egg=flash-attn"

RUN python3.11 -m pip install --force-reinstall transformers==4.53.3 tokenizers==0.21.4 openai==1.75.0 dashscope==1.24.2

RUN python3.11 -m pip install -e /workspace/transschema/AgentFlow/agentflow --no-deps

WORKDIR /workspace/transschema/AgentFlow

CMD ["bash"]
