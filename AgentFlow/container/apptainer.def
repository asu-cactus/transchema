Bootstrap: docker
From: nvcr.io/nvidia/pytorch:25.02-py3

%labels
    Author DataMorpher
    Description CHPC Blackwell-first AgentFlow training image

%environment
    export PYTHONDONTWRITEBYTECODE=1
    export HF_HOME=/scratch/hf_cache
    export CUDA_HOME=/usr/local/cuda
    export PATH=/usr/local/cuda/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
    export PYTHONPATH=/workspace/transschema:/workspace/transschema/AgentFlow${PYTHONPATH:+:$PYTHONPATH}
    export TORCH_CUDA_ARCH_LIST=12.0+PTX
    export VLLM_TARGET_DEVICE=cuda

%setup
    mkdir -p "${APPTAINER_ROOTFS}/uufs"
    mkdir -p "${APPTAINER_ROOTFS}/scratch"
    mkdir -p "${APPTAINER_ROOTFS}/workspace"

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        git \
        curl \
        wget \
        ca-certificates \
        ninja-build \
        pkg-config \
        libnuma-dev \
        libglib2.0-0 \
        libgl1 \
        && rm -rf /var/lib/apt/lists/*

    PYTHON_BIN="$(command -v python || command -v python3)"

    export CUDA_HOME=/usr/local/cuda
    export PATH=/usr/local/cuda/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
    export TORCH_CUDA_ARCH_LIST="12.0+PTX"
    export VLLM_TARGET_DEVICE=cuda
    export MAX_JOBS=8
    export CMAKE_BUILD_PARALLEL_LEVEL=8

    "${PYTHON_BIN}" -m pip install --upgrade \
        pip==24.3.1 \
        setuptools==75.8.0 \
        wheel==0.45.1

    "${PYTHON_BIN}" -m pip install \
        packaging==25.0 \
        ninja==1.11.1.1 \
        numpy==1.26.4 \
        "setuptools_scm<8" \
        "cmake>=3.26,<4"

    # Keep the NGC torch base, then build the GPU-sensitive extensions against it.
    "${PYTHON_BIN}" -m pip install \
        pyvers==0.1.0 \
        tensordict==0.9.1 \
        accelerate \
        codetiming \
        hydra-core \
        peft \
        pybind11 \
        pylatexenc \
        wandb \
        torchdata \
        "ray[default]==2.43.0"

    "${PYTHON_BIN}" -m pip install \
        blake3 \
        cachetools \
        compressed-tensors==0.10.2 \
        depyf==0.18.0 \
        einops \
        "gguf>=0.13.0" \
        lark==1.2.2 \
        "lm-format-enforcer>=0.10.11,<0.11" \
        "mistral_common[opencv]>=1.6.2" \
        msgspec \
        numba==0.61.2 \
        "opencv-python-headless>=4.11.0" \
        outlines==0.1.11 \
        partial-json-parser \
        "prometheus_client>=0.18.0" \
        prometheus-fastapi-instrumentator \
        py-cpuinfo \
        pybase64 \
        python-json-logger \
        "pyzmq>=25.0.0" \
        scipy \
        sentencepiece \
        watchfiles \
        xgrammar==0.1.19 \
        "openai>=1.52.0,<=1.90.0" \
        "fastapi[standard]>=0.115.0,<0.116" \
        llguidance==0.7.30

    # xformers@main requires torch/csrc/stable/ headers that do not exist in the NGC
    # 25.02 torch nightly (2.7.0a0).  vllm 0.9.2 uses Triton/flash-attn kernels and
    # does not need xformers; skip the xformers build entirely.

    # Build the vLLM release used by this project from source against the NGC torch.
    "${PYTHON_BIN}" -m pip install --force-reinstall --no-deps \
        setuptools==75.8.0 wheel==0.45.1 "setuptools_scm<8"
    rm -rf /tmp/vllm-src
    git clone --branch v0.9.2 --depth 1 https://github.com/vllm-project/vllm.git /tmp/vllm-src
    "${PYTHON_BIN}" - <<'PY'
import re
from pathlib import Path

vllm_src = Path("/tmp/vllm-src")

# Patch 1: fix pyproject.toml license field format for setuptools compatibility.
pyproject = vllm_src / "pyproject.toml"
text = pyproject.read_text()
text = text.replace('license = "Apache-2.0"', 'license = { text = "Apache-2.0" }')
text = "\n".join(line for line in text.splitlines() if "license-files" not in line)
pyproject.write_text(text + "\n")

# Patch 2: replace PEP 585 lowercase generics with typing.* forms.
# torch.library.infer_schema in NGC 25.02 torch nightly (2.7.0a0) only accepts the
# typing.* forms; stable torch 2.7.0 added support for PEP 585 lowercase syntax.
_REPLACEMENTS = [
    (r"\blist\[", "List["),
    # dict/tuple/set are NOT valid infer_schema types (only List[X] is), and replacing
    # them breaks runtime constructor calls like dict[str, Any]() which are valid in
    # Python 3.12 but TypeError when spelled as Dict[str, Any]().
]
_ALL_NAMES = {"List"}

patched = []
for py_file in vllm_src.rglob("*.py"):
    try:
        text = py_file.read_text(encoding="utf-8")
    except Exception:
        continue
    new_text = text
    for pattern, replacement in _REPLACEMENTS:
        new_text = re.sub(pattern, replacement, new_text)
    if new_text == text:
        continue
    # Collect typing names that were introduced by this patch and are not yet imported.
    new_names = sorted(
        name for name in _ALL_NAMES
        if re.search(r"\b" + name + r"\[", new_text)
        and not re.search(r"\b" + name + r"\b", text)
    )
    if new_names:
        import_line = "from typing import " + ", ".join(new_names)
        # Insert AFTER any 'from __future__ import' lines — those must come first
        # in a Python file and prepending before them would cause a SyntaxError.
        lines = new_text.split("\n")
        insert_at = 0
        for i, line in enumerate(lines):
            if line.strip().startswith("from __future__ import"):
                insert_at = i + 1
        lines.insert(insert_at, import_line)
        new_text = "\n".join(lines)
    py_file.write_text(new_text, encoding="utf-8")
    patched.append(str(py_file.relative_to(vllm_src)))

print(f"Patched {len(patched)} files (PEP 585 generics -> typing.*):")
for p in sorted(patched):
    print(f"  {p}")
PY
    "${PYTHON_BIN}" -m pip install --no-build-isolation --no-cache-dir --no-deps /tmp/vllm-src
    rm -rf /tmp/vllm-src

    "${PYTHON_BIN}" -m pip install verl==0.5.0 --no-deps

    "${PYTHON_BIN}" -m pip install \
        aiohttp==3.10.4 \
        anthropic==0.40.0 \
        openai==1.75.0 \
        together==1.5.4 \
        google-genai \
        diskcache==5.6.3 \
        easyocr==1.7.2 \
        metapub==0.5.12 \
        pillow==11.1.0 \
        platformdirs==4.3.6 \
        pymed==0.8.9 \
        python-dotenv==1.0.1 \
        setproctitle==1.3.4 \
        sympy==1.13.1 \
        tenacity==9.0.0 \
        wikipedia==1.4.0 \
        dashscope==1.24.2 \
        requests \
        flask \
        omegaconf \
        tqdm \
        datasets==4.3.0 \
        pyarrow==21.0.0 \
        pandas==2.1.4 \
        filelock==3.19.1 \
        pyyaml==6.0.2 \
        python-Levenshtein==0.26.0 \
        scikit-learn==1.5.1 \
        opentelemetry-api==1.29.0 \
        opentelemetry-sdk==1.29.0 \
        opentelemetry-exporter-otlp-proto-http==1.29.0 \
        opentelemetry-exporter-otlp-proto-grpc==1.29.0 \
        opentelemetry-semantic-conventions==0.50b0 \
        psycopg2-binary==2.9.10

    # Provide flash_attn.bert_padding to system Python without forcing a Blackwell
    # CUDA extension build.
    FLASH_ATTENTION_SKIP_CUDA_BUILD=TRUE \
    FLASH_ATTENTION_FORCE_BUILD=FALSE \
      "${PYTHON_BIN}" -m pip install --no-build-isolation --no-cache-dir --no-deps \
        flash-attn==2.7.4.post1

    "${PYTHON_BIN}" -m pip install --force-reinstall \
        transformers==4.53.3 \
        tokenizers==0.21.4 \
        openai==1.75.0 \
        dashscope==1.24.2

    "${PYTHON_BIN}" -m pip install --force-reinstall --no-deps --no-cache-dir \
        numpy==1.26.4 \
        pyarrow==21.0.0 \
        pandas==2.1.4

    # The NGC 25.02 torch nightly (2.7.0a0, Feb 2025) was built against Triton 3.2.x,
    # which still exposes AttrsDescriptor.  Triton 3.3.0 removed AttrsDescriptor from
    # its public API, breaking torch.compile / TorchInductor.  Pin triton here at the
    # very end so no earlier install can upgrade it past 3.2.
    "${PYTHON_BIN}" -m pip install --force-reinstall --no-deps --no-cache-dir \
        triton==3.2.0

%runscript
    exec "$@"
