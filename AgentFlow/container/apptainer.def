Bootstrap: docker
From: nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04

%labels
    Author DataMorpher
    Description CHPC-safe AgentFlow training image with real CUDA/flash-attn stack

%environment
    export PYTHONDONTWRITEBYTECODE=1
    export HF_HOME=/scratch/hf_cache
    export CUDA_HOME=/usr/local/cuda
    export PATH=/usr/local/cuda/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        python3.11 \
        python3.11-dev \
        python3-pip \
        python3.11-venv \
        build-essential \
        git \
        curl \
        wget \
        ca-certificates \
        ninja-build \
        pkg-config \
        libglib2.0-0 \
        libgl1 \
        && rm -rf /var/lib/apt/lists/*

    python3.11 -m pip install --upgrade pip==24.3.1 setuptools==75.8.0 wheel==0.45.1
    python3.11 -m pip install packaging==25.0 ninja==1.11.1.1 numpy==1.26.4

    python3.11 -m pip install \
        torch==2.7.0 torchvision==0.22.0 torchaudio==2.7.0 \
        --index-url https://download.pytorch.org/whl/cu128

    python3.11 -m pip install \
        pyvers==0.1.0 \
        tensordict==0.9.1 \
        accelerate \
        codetiming \
        hydra-core \
        peft \
        pybind11 \
        pylatexenc \
        wandb \
        torchdata \
        "ray[default]==2.43.0"

    python3.11 -m pip install vllm==0.9.2 --no-deps
    python3.11 -m pip install \
        blake3 \
        cachetools \
        compressed-tensors==0.10.2 \
        depyf==0.18.0 \
        einops \
        "gguf>=0.13.0" \
        lark==1.2.2 \
        "lm-format-enforcer>=0.10.11,<0.11" \
        "mistral_common[opencv]>=1.6.2" \
        msgspec \
        numba==0.61.2 \
        "opencv-python-headless>=4.11.0" \
        outlines==0.1.11 \
        partial-json-parser \
        "prometheus_client>=0.18.0" \
        prometheus-fastapi-instrumentator \
        py-cpuinfo \
        pybase64 \
        python-json-logger \
        "pyzmq>=25.0.0" \
        scipy \
        sentencepiece \
        watchfiles \
        xgrammar==0.1.19 \
        "openai>=1.52.0,<=1.90.0" \
        "fastapi[standard]>=0.115.0,<0.116" \
        llguidance==0.7.30

    python3.11 -m pip install verl==0.5.0 --no-deps

    python3.11 -m pip install \
        anthropic==0.40.0 \
        openai==1.75.0 \
        together==1.5.4 \
        google-genai \
        diskcache==5.6.3 \
        easyocr==1.7.2 \
        metapub==0.5.12 \
        pillow==11.1.0 \
        platformdirs==4.3.6 \
        pymed==0.8.9 \
        python-dotenv==1.0.1 \
        sympy==1.13.1 \
        tenacity==9.0.0 \
        wikipedia==1.4.0 \
        dashscope==1.24.2 \
        requests \
        flask \
        omegaconf \
        tqdm \
        datasets==4.3.0 \
        pyarrow==21.0.0 \
        pandas==2.1.4 \
        filelock==3.19.1 \
        pyyaml==6.0.2 \
        python-Levenshtein==0.26.0 \
        scikit-learn==1.5.1 \
        psycopg2-binary==2.9.10

    # Real flash-attn compiled in-container with Python headers and CUDA toolchain.
    export FLASH_ATTENTION_FORCE_BUILD=TRUE
    export MAX_JOBS=8
    python3.11 -m pip install flash-attn==2.7.4.post1 --no-build-isolation --no-cache-dir

    python3.11 -m pip install --force-reinstall transformers==4.53.3 tokenizers==0.21.4

%runscript
    exec "$@"
