Bootstrap: docker
From: nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04

%labels
    Author DataMorpher
    Description CHPC-safe AgentFlow training image with real CUDA/flash-attn stack

%environment
    export PYTHONDONTWRITEBYTECODE=1
    export HF_HOME=/scratch/hf_cache
    export CUDA_HOME=/usr/local/cuda
    export PATH=/usr/local/cuda/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
    export PYTHONPATH=/workspace/transschema:/workspace/transschema/AgentFlow${PYTHONPATH:+:$PYTHONPATH}

%setup
    mkdir -p "${APPTAINER_ROOTFS}/uufs"
    mkdir -p "${APPTAINER_ROOTFS}/scratch"
    mkdir -p "${APPTAINER_ROOTFS}/workspace"

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        python3.11 \
        python3.11-dev \
        python3-pip \
        python3.11-venv \
        build-essential \
        cmake \
        git \
        curl \
        wget \
        ca-certificates \
        ninja-build \
        pkg-config \
        libnuma-dev \
        libglib2.0-0 \
        libgl1 \
        && rm -rf /var/lib/apt/lists/*

    ln -sf /usr/bin/python3.11 /usr/local/bin/python
    ln -sf /usr/bin/pip3 /usr/local/bin/pip

    python3.11 -m pip install --upgrade pip==24.3.1 setuptools==75.8.0 wheel==0.45.1
    python3.11 -m pip install packaging==25.0 ninja==1.11.1.1 numpy==1.26.4 "setuptools_scm<8" "cmake>=3.26,<4"

    # Blackwell (sm_120) requires a coherent CUDA 12.8+ stack. Use cu128 nightly
    # torch wheels here, then build the GPU-sensitive extension packages in-container
    # against the same torch/CUDA toolchain.
    export CUDA_HOME=/usr/local/cuda
    export PATH=/usr/local/cuda/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
    export TORCH_CUDA_ARCH_LIST="12.0+PTX"
    export MAX_JOBS=8
    export CMAKE_BUILD_PARALLEL_LEVEL=8
    export VLLM_TARGET_DEVICE=cuda

    python3.11 -m pip install --pre \
        torch torchvision torchaudio \
        --index-url https://download.pytorch.org/whl/nightly/cu128

    python3.11 -m pip install \
        pyvers==0.1.0 \
        tensordict==0.9.1 \
        accelerate \
        codetiming \
        hydra-core \
        peft \
        pybind11 \
        pylatexenc \
        wandb \
        torchdata \
        "ray[default]==2.43.0"

    python3.11 -m pip install \
        blake3 \
        cachetools \
        compressed-tensors==0.10.2 \
        depyf==0.18.0 \
        einops \
        "gguf>=0.13.0" \
        lark==1.2.2 \
        "lm-format-enforcer>=0.10.11,<0.11" \
        "mistral_common[opencv]>=1.6.2" \
        msgspec \
        numba==0.61.2 \
        "opencv-python-headless>=4.11.0" \
        outlines==0.1.11 \
        partial-json-parser \
        "prometheus_client>=0.18.0" \
        prometheus-fastapi-instrumentator \
        py-cpuinfo \
        pybase64 \
        python-json-logger \
        "pyzmq>=25.0.0" \
        scipy \
        sentencepiece \
        watchfiles \
        xgrammar==0.1.19 \
        "openai>=1.52.0,<=1.90.0" \
        "fastapi[standard]>=0.115.0,<0.116" \
        llguidance==0.7.30

    # xformers wheels lag Blackwell support; compile from source against the active torch.
    python3.11 -m pip install --no-build-isolation --no-cache-dir --no-deps --upgrade \
        "git+https://github.com/facebookresearch/xformers.git@main#egg=xformers"

    # vLLM 0.9.2 is the project version we already target, but the public wheel path
    # is not sufficient for Blackwell. Build the same release from source with sm_120
    # arch enabled instead of using the prebuilt wheel.
    python3.11 -m pip install --force-reinstall --no-deps \
        setuptools==75.8.0 wheel==0.45.1 "setuptools_scm<8"
    rm -rf /tmp/vllm-src
    git clone --branch v0.9.2 --depth 1 https://github.com/vllm-project/vllm.git /tmp/vllm-src
    python3.11 - <<'PY'
from pathlib import Path

pyproject = Path("/tmp/vllm-src/pyproject.toml")
text = pyproject.read_text()
text = text.replace('license = "Apache-2.0"', 'license = { text = "Apache-2.0" }')
text = "\n".join(
    line for line in text.splitlines()
    if "license-files" not in line
)
pyproject.write_text(text + "\n")
PY
    python3.11 -m pip install --no-build-isolation --no-cache-dir --no-deps /tmp/vllm-src
    rm -rf /tmp/vllm-src

    python3.11 -m pip install verl==0.5.0 --no-deps

    python3.11 -m pip install \
        anthropic==0.40.0 \
        openai==1.75.0 \
        together==1.5.4 \
        google-genai \
        diskcache==5.6.3 \
        easyocr==1.7.2 \
        metapub==0.5.12 \
        pillow==11.1.0 \
        platformdirs==4.3.6 \
        pymed==0.8.9 \
        python-dotenv==1.0.1 \
        sympy==1.13.1 \
        tenacity==9.0.0 \
        wikipedia==1.4.0 \
        dashscope==1.24.2 \
        requests \
        flask \
        omegaconf \
        tqdm \
        datasets==4.3.0 \
        pyarrow==21.0.0 \
        pandas==2.1.4 \
        filelock==3.19.1 \
        pyyaml==6.0.2 \
        python-Levenshtein==0.26.0 \
        scikit-learn==1.5.1 \
        opentelemetry-api==1.29.0 \
        opentelemetry-sdk==1.29.0 \
        opentelemetry-exporter-otlp-proto-http==1.29.0 \
        opentelemetry-exporter-otlp-proto-grpc==1.29.0 \
        opentelemetry-semantic-conventions==0.50b0 \
        psycopg2-binary==2.9.10

    # flash-attn is optional on this CHPC path. The training/rollout code already
    # tolerates its absence, and upstream Blackwell source builds are not yet stable
    # enough to make this a hard image requirement.

    python3.11 -m pip install --force-reinstall \
        transformers==4.53.3 \
        tokenizers==0.21.4 \
        openai==1.75.0 \
        dashscope==1.24.2

    # Some transitive deps pull NumPy 2.x, which breaks pandas/datasets ABI here.
    # Re-pin the final runtime pair explicitly so the built SIF is deterministic.
    python3.11 -m pip install --force-reinstall --no-deps --no-cache-dir \
        numpy==1.26.4 \
        pyarrow==21.0.0 \
        pandas==2.1.4

%runscript
    exec "$@"
