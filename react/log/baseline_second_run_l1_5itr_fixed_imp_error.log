-- Start of SQL script

-- Drop the source table if it exists
DROP TABLE IF EXISTS "Source1_88_0";

-- Create the source table with appropriate data types
CREATE TABLE "Source1_88_0" (
    "Airline" TEXT,
    "Date_of_Journey" TEXT,
    "Source" TEXT,
    "Destination" TEXT,
    "Route" TEXT,
    "Dep_Time" TEXT,
    "Arrival_Time" TEXT,
    "Duration" TEXT,
    "Total_Stops" TEXT,
    "Additional_Info" TEXT,
    "Price" DECIMAL
);

-- Import data from CSV file into the source table
COPY "Source1_88_0" FROM '/tmp/github-pipelines/length1_88/test_0.csv' WITH (FORMAT csv, HEADER true, NULL '');

-- Drop the target table if it exists
DROP TABLE IF EXISTS "Target1_88";

-- Create the target table with appropriate data types
CREATE TABLE "Target1_88" (
    "Airline" TEXT,
    "Date_of_Journey" DATE,
    "Source" TEXT,
    "Destination" TEXT,
    "Route" TEXT,
    "Dep_Time" TEXT,
    "Arrival_Time" TEXT,
    "Duration" TEXT,
    "Total_Stops" TEXT,
    "Additional_Info" TEXT,
    "Price" DECIMAL
);

-- Insert data into the target table with transformation
INSERT INTO "Target1_88" (
    "Airline",
    "Date_of_Journey",
    "Source",
    "Destination",
    "Route",
    "Dep_Time",
    "Arrival_Time",
    "Duration",
    "Total_Stops",
    "Additional_Info",
    "Price"
)
SELECT
    "Airline",
    TO_DATE("Date_of_Journey", 'DD/MM/YYYY'),
    "Source",
    "Destination",
    "Route",
    "Dep_Time",
    -- Extract the time part and concatenate with the date part from "Date_of_Journey" to form a timestamp
    (SUBSTRING("Arrival_Time" FROM '^[^ ]+') || ' ' || "Date_of_Journey")::TIMESTAMP,
    "Duration",
    "Total_Stops",
    "Additional_Info",
    "Price"
FROM
    "Source1_88_0";

-- Copy the result into a CSV file
COPY (SELECT * FROM "Target1_88") TO '/tmp/github-pipelines/length1_88/Target1_88_result_baseline.csv' WITH CSV HEADER;

