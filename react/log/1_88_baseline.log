    "Date_of_Journey" TEXT,
    "Source" TEXT,
    "Destination" TEXT,
    "Route" TEXT,
    "Dep_Time" TEXT,
    "Arrival_Time" TEXT,
    "Duration" TEXT,
    "Total_Stops" TEXT,
    "Additional_Info" TEXT,
    "Price" DECIMAL
);

-- Import data from CSV file into the source table
COPY "Source1_88_0" FROM '/tmp/github-pipelines/length1_88/test_0.csv' WITH (FORMAT csv, HEADER true, NULL '');

-- Drop the target table if it exists
DROP TABLE IF EXISTS "Target1_88";

-- Create the target table with appropriate data types
CREATE TABLE "Target1_88" (
    "Airline" TEXT,
    "Date_of_Journey" TEXT,
    "Source" TEXT,
    "Destination" TEXT,
    "Route" TEXT,
    "Dep_Time" TEXT,
    "Arrival_Time" TEXT,
    "Duration" TEXT,
    "Total_Stops" TEXT,
    "Additional_Info" TEXT,
    "Price" DECIMAL
);

-- Insert data into the target table from the source table
-- Assuming that the source and target tables have the same structure and data types
-- No aggregation or conditional transformation is needed based on the provided details
INSERT INTO "Target1_88" (
    "Airline",
    "Date_of_Journey",
    "Source",
    "Destination",
    "Route",
    "Dep_Time",
    "Arrival_Time",
    "Duration",
    "Total_Stops",
    "Additional_Info",
    "Price"
)
