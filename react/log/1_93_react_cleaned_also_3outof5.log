-- Assuming the 'nan' values in the source data are meant to be NULL in the target table
-- and that the brackets in the 'time' field are not required.

-- Step 1: Drop the source table if it exists and create the new source table with appropriate data types
DROP TABLE IF EXISTS "Source1_93_0";
CREATE TABLE "Source1_93_0" (
    "user_id" TEXT,
    "time" TEXT,
    "bet" TEXT,
    "win" TEXT
);

-- Step 2: Import data from the CSV file, treating empty values as NULL and removing brackets from 'time'
COPY "Source1_93_0" ("user_id", "time", "bet", "win")
FROM '/tmp/github-pipelines/length1_93/test_0.csv' WITH (FORMAT csv, HEADER true, NULL 'nan');

-- Step 3: Drop the target table if it exists and create the new target table with appropriate data types
DROP TABLE IF EXISTS "Target1_93";
CREATE TABLE "Target1_93" (
    "user_id" TEXT,
    "time" TIMESTAMP,
    "bet" NUMERIC,
    "win" NUMERIC
);

-- Step 4: Insert data into the target table, transforming the 'user_id' and 'time' fields as required
INSERT INTO "Target1_93" ("user_id", "time", "bet", "win")
SELECT
    -- Extract the user ID after the ' - ' delimiter
    SPLIT_PART("user_id", ' - ', 2) AS "user_id",
    -- Convert 'time' to TIMESTAMP and remove the brackets
    TO_TIMESTAMP(TRIM(BOTH '[]' FROM "time"), 'YYYY-MM-DD HH24:MI:SS') AS "time",
    -- Convert 'bet' to NUMERIC, handling 'nan' as NULL
    NULLIF("bet", 'nan')::NUMERIC AS "bet",
    -- Convert 'win' to NUMERIC, handling 'nan' as NULL
    NULLIF("win", 'nan')::NUMERIC AS "win"
FROM "Source1_93_0";

-- Step 5: Copy the result into a CSV file
COPY (SELECT * FROM "Target1_93") TO '/tmp/github-pipelines/length1_93/Target1_93_result.csv' WITH CSV HEADER;



