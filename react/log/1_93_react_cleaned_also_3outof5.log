-- Drop the source table if it exists
DROP TABLE IF EXISTS "Source1_93_0";

-- Create the source table with all columns as TEXT to handle the data as it is
CREATE TABLE "Source1_93_0" (
    "user_id" TEXT,
    "time" TEXT,
    "bet" TEXT,
    "win" TEXT
);

-- Import data from CSV, treating empty values as NULL and correctly handling date formats
COPY "Source1_93_0" FROM '/tmp/github-pipelines/length1_93/test_0.csv' WITH (FORMAT csv, HEADER true, NULL '');

-- Drop the target table if it exists
DROP TABLE IF EXISTS "Target1_93";

-- Create the target table with all columns as TEXT
CREATE TABLE "Target1_93" (
    "user_id" TEXT,
    "time" TEXT,
    "bet" TEXT,
    "win" TEXT
);

-- Insert transformed data into the target table
INSERT INTO "Target1_93" ("user_id", "time", "bet", "win")
SELECT
    TRIM(SUBSTRING("user_id" FROM 'user_\\d+')), -- Extract the user identifier
    TRIM(BOTH '[]' FROM "time"), -- Remove square brackets from time
    NULLIF("bet", ''), -- Convert empty strings to NULL for bet
    NULLIF("win", '') -- Convert empty strings to NULL for win
FROM
    "Source1_93_0";

-- Copy the result into a CSV file
COPY (SELECT * FROM "Target1_93") TO '/tmp/github-pipelines/length1_93/Target1_93_result.csv' WITH CSV HEADER;
```

