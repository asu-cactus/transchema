-- Drop the existing source table if it exists
DROP TABLE IF EXISTS "Source1_93_0";

-- Create the source table with appropriate data types
CREATE TABLE "Source1_93_0" (
    "user_id" TEXT,
    "time" TEXT,
    "bet" TEXT,
    "win" TEXT
);

-- Load data from the CSV file into the source table
COPY "Source1_93_0" FROM '/tmp/github-pipelines/length1_93/test_0.csv' WITH (FORMAT csv, HEADER true, NULL 'nan');

-- Drop the existing target table if it exists
DROP TABLE IF EXISTS "Target1_93";

-- Create the target table with appropriate data types
CREATE TABLE "Target1_93" (
    "user_id" TEXT,
    "time" TEXT,
    "bet" TEXT,
    "win" TEXT
);

-- Insert data into the target table, transforming the 'user_id' field to remove the prefix
INSERT INTO "Target1_93" ("user_id", "time", "bet", "win")
SELECT
    TRIM(SUBSTRING("user_id" FROM 'user_[0-9]+')), -- Extract the user identifier
    TRIM(BOTH '[]' FROM "time"), -- Remove the square brackets from the 'time' field
    "bet",
    "win"
FROM "Source1_93_0";

