-- Step 1: Analyze using all tools for a comprehensive understanding and accurate data transformation.

-- Step 2: Create Source Table
DROP TABLE IF EXISTS "Source1_93_0";
CREATE TABLE "Source1_93_0" (
    "user_id" TEXT,
    "time" TEXT,
    "bet" TEXT,
    "win" TEXT
);

-- Step 3: Data Import
COPY "Source1_93_0" FROM '/tmp/github-pipelines/length1_93/test_0.csv' WITH (FORMAT csv, HEADER true, NULL 'nan');

-- Step 4: Create Target Table
DROP TABLE IF EXISTS "Target1_93";
CREATE TABLE "Target1_93" (
    "user_id" TEXT,
    "time" TIMESTAMP,
    "bet" DECIMAL,
    "win" DECIMAL
);

-- Step 5: Data Transformation and Insertion into Target Table
-- Assuming that the 'nan' values in 'bet' and 'win' columns are placeholders for NULLs in numeric context
-- and that the square brackets in 'time' column are not required in the target table.
INSERT INTO "Target1_93" ("user_id", "time", "bet", "win")
SELECT
    TRIM(SUBSTRING("user_id" FROM 'user_[0-9]+')), -- Extracting the user ID
    TO_TIMESTAMP(REPLACE("time", '[', ''), 'YYYY-MM-DD HH24:MI:SS'), -- Removing brackets and converting to TIMESTAMP
    NULLIF("bet", 'nan')::DECIMAL, -- Converting 'bet' to DECIMAL, treating 'nan' as NULL
    NULLIF("win", 'nan')::DECIMAL  -- Converting 'win' to DECIMAL, treating 'nan' as NULL
FROM
    "Source1_93_0";

-- Step 6: COPY the SQL result into a CSV file
COPY (SELECT * FROM "Target1_93") TO '/tmp/github-pipelines/length1_93/Target1_93_result.csv' WITH CSV HEADER;



