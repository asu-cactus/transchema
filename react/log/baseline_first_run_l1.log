-- Step 2: Create Source Table
DROP TABLE IF EXISTS "Source1_71_0";
CREATE TABLE "Source1_71_0" (
    "RegionID" INTEGER,
    "Region" TEXT,
    "Provincia" TEXT,
    "Comuna" TEXT,
    "Superficie" DECIMAL,
    "Poblacion" DECIMAL,
    "Densidad" DECIMAL,
    "IDH_2005" DECIMAL
);

-- Step 3: Data Import
