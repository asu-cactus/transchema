-- Step 4: Create Target Table
DROP TABLE IF EXISTS "Target1_71";
CREATE TABLE "Target1_71" (
    "Region" TEXT,
    "Poblacion" DECIMAL,
    "Superficie" DECIMAL
);

-- Step 5: Transform and Load Data
-- Since the target table requires aggregated data, we will group by Region and sum the Poblacion and Superficie
INSERT INTO "Target1_71" ("Region", "Poblacion", "Superficie")
SELECT
    "Region",
    SUM("Poblacion") AS "Poblacion",
    SUM("Superficie") AS "Superficie"
FROM
    "Source1_71_0"
GROUP BY
    "Region";

