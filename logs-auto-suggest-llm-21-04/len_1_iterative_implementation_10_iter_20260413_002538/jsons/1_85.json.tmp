        "code": "import pandas as pd\n\n# Paths to source CSV files\nsource0_path = \"autopipeline-benchmarks/github-pipelines/length1_85/test_0.csv\"\nsource1_path = \"autopipeline-benchmarks/github-pipelines/length1_85/test_1.csv\"\n\n# Load source tables with index_col=0 to ignore the numerical index column\ndf0 = pd.read_csv(source0_path, index_col=0)\ndf1 = pd.read_csv(source1_path, index_col=0)\n\n# Join df1 and df0 on 'calaccess_committee_id' only\n# 'calaccess_filing_id' exists only in df0, so we cannot join on it\n# Use suffixes to distinguish committee_name columns from each source\ndf_joined = pd.merge(df1, df0, on='calaccess_committee_id', how='inner', suffixes=('_x', '_y'))\n\n# Target schema columns in order\ntarget_columns = [\n    'ocd_prop_id', 'calaccess_prop_id', 'ccdc_prop_id', 'prop_name', 'ccdc_committee_id',\n    'calaccess_committee_id', 'committee_name_x', 'committee_position', 'committee_name_y',\n    'calaccess_filing_id', 'date_received', 'contributor_lastname', 'contributor_firstname',\n    'contributor_city', 'contributor_state', 'contributor_zip', 'contributor_employer',\n    'contributor_occupation', 'contributor_is_self_employed', 'amount'\n]\n\n# Select and reorder columns to match target schema\ndf_result = df_joined[target_columns]\n\n# Ensure correct data types as per target schema\ndf_result['calaccess_prop_id'] = df_result['calaccess_prop_id'].astype(int)\ndf_result['ccdc_prop_id'] = df_result['ccdc_prop_id'].astype(int)\ndf_result['ccdc_committee_id'] = df_result['ccdc_committee_id'].astype(int)\ndf_result['calaccess_committee_id'] = df_result['calaccess_committee_id'].astype(int)\ndf_result['calaccess_filing_id'] = df_result['calaccess_filing_id'].astype(int)\ndf_result['date_received'] = pd.to_datetime(df_result['date_received']).dt.strftime('%Y-%m-%d')\ndf_result['contributor_is_self_employed'] = df_result['contributor_is_self_employed'].astype(bool)\ndf_result['amount'] = df_result['amount'].astype(float)\n\n# Write the final dataframe to the target CSV file\noutput_path = \"autopipeline-benchmarks/github-pipelines/length1_85/target_multisource.csv\"\ndf_result.to_csv(output_path, index=False)",
