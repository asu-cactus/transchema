f_employed\"] = df_joined[\"contributor_is_self_employed\"].apply(to_bool)\n\n# amount (float)\ntarget_df[\"amount\"] = pd.to_numeric(df_joined[\"amount\"], errors='coerce').fillna(0.0).astype(float)\n\n# Write the result to the target path\ntarget_path = \"autopipeline-benchmarks/github-pipelines/length1_19/target_multisource.csv\"\ntarget_df.to_csv(target_path, index=False)",
