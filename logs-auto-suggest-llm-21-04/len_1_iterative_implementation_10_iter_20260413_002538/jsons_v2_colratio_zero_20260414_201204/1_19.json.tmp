        "code": "import pandas as pd\n\n# File paths for source tables\nsource0_path = \"autopipeline-benchmarks/github-pipelines/length1_19/test_0.csv\"\nsource1_path = \"autopipeline-benchmarks/github-pipelines/length1_19/test_1.csv\"\n\n# Load source tables with index_col=0 to ignore the numerical index column\ndf0 = pd.read_csv(source0_path, index_col=0)\ndf1 = pd.read_csv(source1_path, index_col=0)\n\n# According to operation_history:\n# JOIN : [[\"Source1_19_0\",\"Source1_19_1\"],[\"calaccess_committee_id\",\"calaccess_committee_id\"]]\n# Join df0 and df1 on 'calaccess_committee_id'\n\n# Before join, rename committee_name in df0 and df1 to distinguish them after join\ndf0_renamed = df0.rename(columns={\"committee_name\": \"committee_name_x\"})\ndf1_renamed = df1.rename(columns={\"committee_name\": \"committee_name_y\"})\n\n# Perform inner join on 'calaccess_committee_id'\ndf_joined = pd.merge(\n    df0_renamed,\n    df1_renamed,\n    how=\"inner\",\n    on=\"calaccess_committee_id\",\n    suffixes=('_x', '_y')  # suffixes already handled by renaming committee_name columns explicitly\n)\n\n# Now, construct the target dataframe with the exact target schema and types:\n# Target Schema:\n# ['ocd_prop_id': string,\n#  'calaccess_prop_id': integer,\n#  'ccdc_prop_id': integer,\n#  'prop_name': string,\n#  'ccdc_committee_id': integer,\n#  'calaccess_committee_id': integer,\n#  'committee_name_x': string,\n#  'committee_position': string,\n#  'committee_name_y': string,\n#  'calaccess_filing_id': integer,\n#  'date_received': string,\n#  'contributor_lastname': string,\n#  'contributor_firstname': string,\n#  'contributor_city': string,\n#  'contributor_state': string,\n#  'contributor_zip': string,\n#  'contributor_employer': string,\n#  'contributor_occupation': string,\n#  'contributor_is_self_employed': boolean,\n#  'amount': float]\n\n# Select and convert columns accordingly\n\n# For integer columns, ensure type conversion (some may be read as float if missing values)\nint_cols = [\n    \"calaccess_prop_id\",\n    \"ccdc_prop_id\",\n    \"ccdc_committee_id\",\n    \"calaccess_committee_id\",\n    \"calaccess_filing_id\",\n]\n\n# For boolean column\nbool_col = \"contributor_is_self_employed\"\n\n# For float column\nfloat_col = \"amount\"\n\n# Build the target dataframe step by step\ntarget_df = pd.DataFrame()\n\n# ocd_prop_id (string)\ntarget_df[\"ocd_prop_id\"] = df_joined[\"ocd_prop_id\"].astype(str)\n\n# calaccess_prop_id (integer)\ntarget_df[\"calaccess_prop_id\"] = pd.to_numeric(df_joined[\"calaccess_prop_id\"], errors='coerce').fillna(0).astype(int)\n\n# ccdc_prop_id (integer)\ntarget_df[\"ccdc_prop_id\"] = pd.to_numeric(df_joined[\"ccdc_prop_id\"], errors='coerce').fillna(0).astype(int)\n\n# prop_name (string)\ntarget_df[\"prop_name\"] = df_joined[\"prop_name\"].astype(str)\n\n# ccdc_committee_id (integer)\ntarget_df[\"ccdc_committee_id\"] = pd.to_numeric(df_joined[\"ccdc_committee_id\"], errors='coerce').fillna(0).astype(int)\n\n# calaccess_committee_id (integer)\ntarget_df[\"calaccess_committee_id\"] = pd.to_numeric(df_joined[\"calaccess_committee_id\"], errors='coerce').fillna(0).astype(int)\n\n# committee_name_x (string) - from df0 renamed column\ntarget_df[\"committee_name_x\"] = df_joined[\"committee_name_x\"].astype(str)\n\n# committee_position (string) - from df0\ntarget_df[\"committee_position\"] = df_joined[\"committee_position\"].astype(str)\n\n# committee_name_y (string) - from df1 renamed column\ntarget_df[\"committee_name_y\"] = df_joined[\"committee_name_y\"].astype(str)\n\n# calaccess_filing_id (integer) - from df1\ntarget_df[\"calaccess_filing_id\"] = pd.to_numeric(df_joined[\"calaccess_filing_id\"], errors='coerce').fillna(0).astype(int)\n\n# date_received (string) - from df1\n# Keep as string, but ensure no NaN\ntarget_df[\"date_received\"] = df_joined[\"date_received\"].astype(str)\n\n# contributor_lastname (string) - from df1\ntarget_df[\"contributor_lastname\"] = df_joined[\"contributor_lastname\"].astype(str)\n\n# contributor_firstname (string) - from df1\ntarget_df[\"contributor_firstname\"] = df_joined[\"contributor_firstname\"].astype(str)\n\n# contributor_city (string) - from df1\ntarget_df[\"contributor_city\"] = df_joined[\"contributor_city\"].astype(str)\n\n# contributor_state (string) - from df1\ntarget_df[\"contributor_state\"] = df_joined[\"contributor_state\"].astype(str)\n\n# contributor_zip (string) - from df1\ntarget_df[\"contributor_zip\"] = df_joined[\"contributor_zip\"].astype(str)\n\n# contributor_employer (string) - from df1\ntarget_df[\"contributor_employer\"] = df_joined[\"contributor_employer\"].astype(str)\n\n# contributor_occupation (string) - from df1\ntarget_df[\"contributor_occupation\"] = df_joined[\"contributor_occupation\"].astype(str)\n\n# contributor_is_self_employed (boolean) - from df1\n# Convert to boolean, handling possible string or numeric representations\ndef to_bool(val):\n    if pd.isna(val):\n        return False\n    if isinstance(val, bool):\n        return val\n    if isinstance(val, (int, float)):\n        return bool(val)\n    val_str = str(val).strip().lower()\n    if val_str in ['true', '1', 'yes']:\n        return True\n    return False\n\ntarget_df[\"contributor_is_self_employed\"] = df_joined[\"contributor_is_self_employed\"].apply(to_bool)\n\n# amount (float) - from df1\ntarget_df[\"amount\"] = pd.to_numeric(df_joined[\"amount\"], errors='coerce').fillna(0.0).astype(float)\n\n# Write the result to the target path\ntarget_path = \"autopipeline-benchmarks/github-pipelines/length1_19/target_multisource.csv\"\ntarget_df.to_csv(target_path, index=False)",
