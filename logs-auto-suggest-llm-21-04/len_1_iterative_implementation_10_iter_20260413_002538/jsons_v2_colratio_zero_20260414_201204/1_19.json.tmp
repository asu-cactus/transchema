        "code": "import pandas as pd\n\n# File paths for source tables\nsource0_path = \"autopipeline-benchmarks/github-pipelines/length1_19/test_0.csv\"\nsource1_path = \"autopipeline-benchmarks/github-pipelines/length1_19/test_1.csv\"\n\n# Load source tables with index_col=0 to ignore the numerical index column\ndf0 = pd.read_csv(source0_path, index_col=0)\ndf1 = pd.read_csv(source1_path, index_col=0)\n\n# Rename 'committee_name' columns in both dataframes to distinguish after join\ndf0_renamed = df0.rename(columns={\"committee_name\": \"committee_name_x\"})\ndf1_renamed = df1.rename(columns={\"committee_name\": \"committee_name_y\"})\n\n# Perform inner join on 'calaccess_committee_id'\ndf_joined = pd.merge(\n    df0_renamed,\n    df1_renamed,\n    how=\"inner\",\n    on=\"calaccess_committee_id\",\n    suffixes=('_x', '_y')  # suffixes are already handled by renaming\n)\n\n# Prepare target dataframe with exact schema and types\n\n# Integer columns that need conversion\nint_cols = [\n    \"calaccess_prop_id\",\n    \"ccdc_prop_id\",\n    \"ccdc_committee_id\",\n    \"calaccess_committee_id\",\n    \"calaccess_filing_id\",\n]\n\n# Boolean column\nbool_col = \"contributor_is_self_employed\"\n\n# Float column\nfloat_col = \"amount\"\n\n# Helper function to convert various representations to boolean\ndef to_bool(val):\n    if pd.isna(val):\n        return False\n    if isinstance(val, bool):\n        return val\n    if isinstance(val, (int, float)):\n        return bool(val)\n    val_str = str(val).strip().lower()\n    if val_str in ['true', '1', 'yes']:\n        return True\n    return False\n\n# Build the target dataframe step by step\ntarget_df = pd.DataFrame()\n\n# ocd_prop_id (string)\ntarget_df[\"ocd_prop_id\"] = df_joined[\"ocd_prop_id\"].astype(str)\n\n# calaccess_prop_id (integer)\ntarget_df[\"calaccess_prop_id\"] = pd.to_numeric(df_joined[\"calaccess_prop_id\"], errors='coerce').fillna(0).astype(int)\n\n# ccdc_prop_id (integer)\ntarget_df[\"ccdc_prop_id\"] =