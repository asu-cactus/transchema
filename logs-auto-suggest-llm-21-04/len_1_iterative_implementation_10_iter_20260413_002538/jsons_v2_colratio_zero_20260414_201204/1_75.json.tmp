        "code": "import pandas as pd\nimport numpy as np\n\n# Source file path (only one source table given)\nsource_path_0 = \"autopipeline-benchmarks/github-pipelines/length1_75/test_0.csv\"\n\n# Load source data with index_col=0 to ignore the numerical index column\ndf0 = pd.read_csv(source_path_0, index_col=0)\n\n# --- Transformation Plan ---\n# Target schema columns:\n# ['neighbourhood': string,\n#  'id': int,\n#  'name': int,\n#  'host_id': int,\n#  'host_name': int,\n#  'neighbourhood_group': int,\n#  'latitude': int,\n#  'longitude': int,\n#  'room_type': int,\n#  'price': int,\n#  'minimum_nights': int,\n#  'number_of_reviews': int,\n#  'last_review': int,\n#  'reviews_per_month': int,\n#  'calculated_host_listings_count': int,\n#  'availability_365': int]\n\n# The source table has the same columns as the target schema except types differ:\n# - 'neighbourhood' is string (grouping key)\n# - 'last_review' is date string, needs conversion to integer timestamp\n# - Other columns are mostly numeric or categorical strings that need to be converted to integers\n\n# Since the target has 70 unique neighbourhoods, and source has many rows per neighbourhood,\n# we aggregate by 'neighbourhood' to produce one row per neighbourhood.\n\n# Aggregation strategy:\n# - For columns that are categorical strings but target expects int, we will encode them as integers by factorizing.\n# - For numeric columns, aggregate by mean and then round to int.\n# - For 'last_review', convert to datetime, then to integer timestamp (seconds since epoch), aggregate by mean, then round.\n# - For columns that are IDs or names but target expects int, aggregate by taking the first value per group (assuming consistent).\n\n# Step 1: Convert 'last_review' to datetime, then to integer timestamp (seconds since epoch)\ndf0['last_review'] = pd.to_datetime(df0['last_review'], errors='coerce')\ndf0['last_review_int'] = df0['last_review'].view('int64') // 10**9  # nanoseconds to seconds\n\n# Step 2: Encode categorical string columns that appear as strings but target expects int:\n# Columns: 'name', 'host_name', 'neighbourhood_group', 'room_type'\n# We will factorize these columns to integer codes before aggregation.\n\nfor col in ['name', 'host_name', 'neighbourhood_group', 'room_type']:\n    df0[col] = pd.factorize(df0[col])[0]\n\n# Step 3: Define aggregation dictionary\nagg_dict = {\n    'id': 'first',  # take first id per neighbourhood (assuming consistent)\n    'name': 'first',  # encoded integer\n    'host_id': 'first',\n    'host_name': 'first',  # encoded integer\n    'neighbourhood_group': 'first',  # encoded integer\n    'latitude': 'mean',\n    'longitude': 'mean',\n    'room_type': 'first',  # encoded integer\n    'price': 'mean',\n    'minimum_nights': 'mean',\n    'number_of_reviews': 'mean',\n    'last_review_int': 'mean',\n    'reviews_per_month': 'mean',\n    'calculated_host_listings_count': 'mean',\n    'availability_365': 'mean'\n}\n\n# Step 4: Group by 'neighbourhood' and aggregate\ngrouped = df0.groupby('neighbourhood').agg(agg_dict).reset_index()\n\n# Step 5: Round numeric columns to integers as target expects integers\n# Columns to round: all except 'neighbourhood' (string)\nint_columns = ['id', 'name', 'host_id', 'host_name', 'neighbourhood_group',\n               'latitude', 'longitude', 'room_type', 'price', 'minimum_nights',\n               'number_of_reviews', 'last_review_int', 'reviews_per_month',\n               'calculated_host_listings_count', 'availability_365']\n\nfor col in int_columns:\n    # Some columns might have NaNs, use Int64 dtype to allow nullable integers\n    grouped[col] = grouped[col].round().astype('Int64')\n\n# Step 6: Rename 'last_review_int' back to 'last_review'\ngrouped = grouped.rename(columns={'last_review_int': 'last_review'})\n\n# Step 7: Reorder columns to match target schema exactly\ntarget_columns = ['neighbourhood', 'id', 'name', 'host_id', 'host_name', 'neighbourhood_group',\n                  'latitude', 'longitude', 'room_type', 'price', 'minimum_nights', 'number_of_reviews',\n                  'last_review', 'reviews_per_month', 'calculated_host_listings_count', 'availability_365']\n\ngrouped = grouped[target_columns]\n\n# Step 8: Save the transformed data to the target CSV file\noutput_path = \"autopipeline-benchmarks/github-pipelines/length1_75/target_multisource.csv\"\ngrouped.to_csv(output_path, index=False)",
