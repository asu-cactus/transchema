          "code": "import pandas as pd\n\n# Load source data with index_col=0 to ignore the numerical index column\nsource_path_0 = \"autopipeline-benchmarks/github-pipelines/length1_75/test_0.csv\"\ndf = pd.read_csv(source_path_0, index_col=0)\n\n# Convert 'last_review' to datetime\ndf['last_review'] = pd.to_datetime(df['last_review'], errors='coerce')\n\n# Group by 'neighbourhood' (unique string column)\ngroupby_cols = ['neighbourhood']\n\n# Aggregation dictionary:\n# - For IDs and counts, use nunique (count distinct)\n# - For numeric columns, use mean\n# - For categorical strings, take first (will factorize later)\nagg_dict = {\n    'id': 'nunique',                    # count distinct ids per neighbourhood\n    'name': 'first',                   # string, take first per neighbourhood\n    'host_id': 'nunique',              # count distinct host_id per neighbourhood\n    'host_name': 'first',              # string, take first\n    'neighbourhood_group': 'first',   # string, take first\n    'latitude': 'mean',\n    'longitude': 'mean',\n    'room_type': 'first',              # string, take first\n    'price': 'mean',\n    'minimum_nights': 'mean',\n    'number_of_reviews': 'mean',\n    'last_review': 'max',              # take latest review date per neighbourhood\n    'reviews_per_month': 'mean',\n    'calculated_host_listings_count': 'mean',\n    'availability_365': 'mean'\n}\n\ngrouped = df.groupby(groupby_cols).agg(agg_dict).reset_index()\n\n# Convert 'last_review' datetime to integer seconds since epoch\ngrouped['last_review'] = grouped['last_review'].view('int64') // 10**9\ngrouped['last_review'] = grouped['last_review'].fillna(0).astype('Int64')\n\n# Factorize categorical columns to convert strings to integers\nfor col in ['name', 'host_name', 'neighbourhood_group', 'room_type']:\n    grouped[col], _ = pd.factorize(grouped[col])\n\n# Round numeric columns to integers\nint_cols = [\n    'id', 'host_id', 'neighbourhood_group', 'latitude', 'longitude', 'room_type',\n    'price', 'minimum_nights', 'number_of_reviews', 'last_review',\n    'reviews_per_month', 'calculated_host_listings_count', 'availability_365'\n]\n\nfor col in int_cols:\n    grouped[col] = grouped[col].round().astype('Int64')\n\n# Reorder columns to match target schema exactly\ntarget_columns = [\n    'neighbourhood', 'id', 'name', 'host_id', 'host_name', 'neighbourhood_group',\n    'latitude', 'longitude', 'room_type', 'price', 'minimum_nights', 'number_of_reviews',\n    'last_review', 'reviews_per_month', 'calculated_host_listings_count', 'availability_365'\n]\n\ngrouped = grouped[target_columns]\n\n# Save the transformed data to the target CSV file\noutput_path = \"autopipeline-benchmarks/github-pipelines/length1_75/target_multisource_critique_history.csv\"\ngrouped.to_csv(output_path, index=False)"
