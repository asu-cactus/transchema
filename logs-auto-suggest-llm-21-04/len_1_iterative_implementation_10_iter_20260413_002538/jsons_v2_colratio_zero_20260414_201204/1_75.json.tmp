26, 5, so likely these are encoded as integer IDs.\n#   We'll encode these categorical columns as integer codes.\n# - For latitude and longitude, source is float, target is integer, so round to int.\n# - For all other numeric columns, convert to int directly.\n# - Finally, reorder columns to target schema order.\n\n# Columns to encode as categorical integers:\ncategorical_cols = ['name', 'host_name', 'neighbourhood_group', 'room_type']\n\n# Convert 'last_review' to integer days since 1970-01-01, NaT to 0\ndf0['last_review'] = pd.to_datetime(df0['last_review'], errors='coerce')\nepoch = pd.Timestamp('1970-01-01')\ndf0['last_review'] = (df0['last_review'] - epoch).dt.days.fillna(0).astype(int)\n\n# Encode categorical columns as integer codes starting from 1 (to avoid 0 which may mean missing)\nfor col in categorical_cols:\n    df0[col] = df0[col].astype('category').cat.codes + 1\n\n# Convert 'reviews_per_month' float to int by rounding\ndf0['reviews_per_month'] = df0['reviews_per_month'].round().fillna(0).astype(int)\n\n# Convert latitude and longitude to int by rounding\ndf0['latitude'] = df0['latitude'].round().astype(int)\ndf0['longitude'] = df0['longitude'].round().astype(int)\n\n# Convert all other numeric columns to int\nint_cols = ['id', 'host_id', 'price', 'minimum_nights', 'number_of_reviews',\n            'calculated_host_listings_count', 'availability_365']\n\nfor col in int_cols:\n    df0[col] = pd.to_numeric(df0[col], errors='coerce').fillna(0).astype(int)\n\n# 'neighbourhood' remains string\ndf0['neighbourhood'] = df0['neighbourhood'].astype(str)\n\n# Reorder columns to target schema\ntarget_columns = ['neighbourhood', 'id', 'name', 'host_id', 'host_name', 'neighbourhood_group',\n                  'latitude', 'longitude', 'room_type', 'price', 'minimum_nights', 'number_of_reviews',\n                  'last_review', 'reviews_per_month', 'calculated_host_listings_count', 'availability_365']\n\ndf_target = df0[target_columns]\n\n# Write the transformed data to the target CSV file\noutput_path = \"autopipeline-benchmarks/github-pipelines/length1_75/target_multisource.csv\"\ndf_target.to_csv(output_path, index=False)",
