000836617397', '120.91696662057332', 'price'\n]\n\n# Step 3: Load source data\n# According to the source info, only one source file is given: Source1_89_0\n# The source schema: ['ticker', 'date', 'open', 'high', 'low', 'close', 'volume', 'adj_close', 'adj_volume']\n# The source file has an index column to ignore (index_col=0)\ndf_source = pd.read_csv(source_files[0], index_col=0)\n\n# Step 4: Inspect source data and transform to target schema\n# The target schema has 'date' as string and many float columns named as floats (e.g. '104.0', '105.0870744880627', etc.) plus 'price'\n# The source data columns are different and do not match target columns except 'date' and 'ticker' (ticker is not in target)\n# The source data's first row looks like a header row repeated or malformed (from example):\n#    ticker        date    open  high  low  close  volume  adj_close  adj_volume\n# 0  price        date  ticker   NaN  NaN    NaN     NaN       NaN         NaN\n# So we need to clean this first row if it is a header row repeated or malformed.\n\n# Step 4a: Remove any rows that are not valid data (e.g., rows where 'date' == 'date' or 'ticker' == 'price')\ndf_source_clean = df_source[~((df_source['date'] == 'date') | (df_source['ticker'] == 'price'))].copy()\n\n# Step 4b: Convert 'date' column to string (already string, but ensure no issues)\ndf_source_clean['date'] = df_source_clean['date'].astype(str)\n\n# Step 4c: The target columns except 'date' and 'price' are many float columns named as floats.\n# The source data has no columns matching these float column names.\n# The source data has columns: ticker, date, open, high, low, close, volume, adj_close, adj_volume\n# The target columns are mostly float numbers as strings, plus 'price' at the end.\n# The source data's 'ticker' column contains values like '104.0', '104.87815067615534', which look like the float column names in target.\n# The source data's 'date' column contains dates.\n# The source data's 'open', 'high', 'low', 'close', 'volume', 'adj_close', 'adj_volume' columns are mostly NaN in example.\n# The first row in source data is malformed, but after cleaning, the 'ticker' column contains float-like strings that match target columns.\n# So the source data is in a \"long\" format where each row corresponds to a (ticker, date) pair, where ticker is a float string matching target columns.\n# The target table is in \"wide\" format with one row per date, and columns for each ticker (float string) plus price.\n\n# Step 4d: We need to pivot the source data from long to wide:\n# - index: date\n# - columns: ticker (which are float strings matching target columns except 'price')\n# - values: We need to decide which value to use for each (date, ticker).\n#   The source data's 'open', 'high', 'low', 'close', 'volume', 'adj_close', 'adj_volume' are mostly NaN.\n#   The example source data shows NaNs in these columns.\n#   The first row is malformed, but subsequent rows have 'ticker' as float strings and 'date' as date.\n#   The target examples show mostly NaNs in the float columns.\n#   The target also has a 'price' column, which is not in source data explicitly.\n#   The source data's 'ticker' column contains the float column names, so we can pivot on that.\n#   The source data's 'close' or 'open' or 'adj_close' might be the value to pivot.\n#   Since the example source data shows NaNs in these columns, we will pivot using 'close' as the value.\n#   If 'close' is NaN, the pivot will have NaN.\n\n# Step 4e: Pivot the data\ndf_pivot = df_source_clean.pivot(index='date', columns='ticker', values='close')\n\n# Step 4f: The pivot columns are the tickers (float strings), but may not cover all target float columns.\n# We need to ensure all target float columns are present in the final dataframe.\n# Add missing columns with NaN\nfor col in target_columns:\n    if col != 'date' and col != 'price' and col not in df_pivot.columns:\n        df_pivot[col] = pd.NA\n\n# Step 4g: Reorder columns to match target schema (except 'date' which is index now)\ndf_pivot = df_pivot[target_columns[1:-1]]  # all float columns except 'date' and 'price'\n\n# Step 4h: Reset index to bring 'date' back as a column\ndf_pivot.reset_index(inplace=True)\n\n# Step 4i: Add 'price' column to the dataframe\n# The source data does not have a 'price' column explicitly.\n# The target examples show 'price' column with NaNs.\n# We will add 'price' column filled with NaN to match target schema.\ndf_pivot['price'] = pd.NA\n\n# Step 4j: Ensure 'date' column is string type\ndf_pivot['date'] = df_pivot['date'].astype(str)\n\n# Step 4k: Ensure all float columns are float dtype (convert if possible)\nfloat_cols = [col for col in target_columns if col not in ['date', 'price']]\nfor col in float_cols:\n    df_pivot[col] = pd.to_numeric(df_pivot[col], errors='coerce')\n\n# Step 5: Export the transformed dataframe to the target CSV path\noutput_path = \"autopipeline-benchmarks/github-pipelines/length1_89/target_multisource.csv\"\ndf_pivot.to_csv(output_path, index=False)",
