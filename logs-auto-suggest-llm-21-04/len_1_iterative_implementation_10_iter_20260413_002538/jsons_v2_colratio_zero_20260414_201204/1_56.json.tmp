ittee_id',\n# 'calaccess_committee_id', 'committee_name' (will be committee_name_x), 'committee_position'\n\n# Columns from df0 (right):\n# 'committee_name' (will be committee_name_y), 'calaccess_filing_id', 'date_received',\n# 'contributor_lastname', 'contributor_firstname', 'contributor_city', 'contributor_state',\n# 'contributor_zip', 'contributor_employer', 'contributor_occupation',\n# 'contributor_is_self_employed', 'amount'\n\n# Rename columns to match target schema exactly\n\ndf_result = pd.DataFrame()\n\n# From df1 (left side)\ndf_result[\"ocd_prop_id\"] = df_joined[\"ocd_prop_id\"].astype(str)\ndf_result[\"calaccess_prop_id\"] = pd.to_numeric(df_joined[\"calaccess_prop_id\"], errors='coerce').astype(\"Int64\")\ndf_result[\"ccdc_prop_id\"] = pd.to_numeric(df_joined[\"ccdc_prop_id\"], errors='coerce').astype(\"Int64\")\ndf_result[\"prop_name\"] = df_joined[\"prop_name\"].astype(str)\ndf_result[\"ccdc_committee_id\"] = pd.to_numeric(df_joined[\"ccdc_committee_id\"], errors='coerce').astype(\"Int64\")\ndf_result[\"calaccess_committee_id\"] = pd.to_numeric(df_joined[\"calaccess_committee_id\"], errors='coerce').astype(\"Int64\")\ndf_result[\"committee_name_x\"] = df_joined[\"committee_name_x\"].astype(str)\ndf_result[\"committee_position\"] = df_joined[\"committee_position\"].astype(str)\n\n# From df0 (right side)\ndf_result[\"committee_name_y\"] = df_joined[\"committee_name_y\"].astype(str)\ndf_result[\"calaccess_filing_id\"] = pd.to_numeric(df_joined[\"calaccess_filing_id\"], errors='coerce').astype(\"Int64\")\ndf_result[\"date_received\"] = df_joined[\"date_received\"].astype(str)\ndf_result[\"contributor_lastname\"] = df_joined[\"contributor_lastname\"].astype(str)\ndf_result[\"contributor_firstname\"] = df_joined[\"contributor_firstname\"].astype(str)\ndf_result[\"contributor_city\"] = df_joined[\"contributor_city\"].astype(str)\ndf_result[\"contributor_state\"] = df_joined[\"contributor_state\"].astype(str)\ndf_result[\"contributor_zip\"] = df_joined[\"contributor_zip\"].astype(str)\ndf_result[\"contributor_employer\"] = df_joined[\"contributor_employer\"].astype(str)\ndf_result[\"contributor_occupation\"] = df_joined[\"contributor_occupation\"].astype(str)\n\n# contributor_is_self_employed is boolean\n# The source column contributor_is_self_employed might be boolean or string, ensure boolean\ndf_result[\"contributor_is_self_employed\"] = df_joined[\"contributor_is_self_employed\"].map(\n    lambda x: bool(x) if pd.notnull(x) else False\n)\n\n# amount is float\ndf_result[\"amount\"] = pd.to_numeric(df_joined[\"amount\"], errors='coerce').astype(float)\n\n# Write the result to the specified path\noutput_path = \"autopipeline-benchmarks/github-pipelines/length1_56/target_multisource.csv\"\ndf_result.to_csv(output_path, index=False)",
