        "code": "import pandas as pd\n\n# Paths to source CSV files\nsource0_path = \"autopipeline-benchmarks/github-pipelines/length1_56/test_0.csv\"\nsource1_path = \"autopipeline-benchmarks/github-pipelines/length1_56/test_1.csv\"\n\n# Load source tables with index_col=0 to ignore the numerical index column\ndf0 = pd.read_csv(source0_path, index_col=0)\ndf1 = pd.read_csv(source1_path, index_col=0)\n\n# Join df1 and df0 on 'calaccess_committee_id'\n# df1 columns: ['ocd_prop_id', 'calaccess_prop_id', 'ccdc_prop_id', 'prop_name', 'ccdc_committee_id', 'calaccess_committee_id', 'committee_name', 'committee_position']\n# df0 columns: ['calaccess_committee_id', 'committee_name', 'calaccess_filing_id', 'date_received', 'contributor_lastname', 'contributor_firstname', 'contributor_city', 'contributor_state', 'contributor_zip', 'contributor_employer', 'contributor_occupation', 'contributor_is_self_employed', 'amount']\n\n# After join, committee_name columns from both sources will be suffixed by pandas merge:\n# committee_name_x from df1, committee_name_y from df0\n\ndf_joined = pd.merge(df1, df0, on='calaccess_committee_id', how='inner', suffixes=('_x', '_y'))\n\n# Target schema columns in order:\ntarget_columns = [\n    'ocd_prop_id', 'calaccess_prop_id', 'ccdc_prop_id', 'prop_name', 'ccdc_committee_id',\n    'calaccess_committee_id', 'committee_name_x', 'committee_position', 'committee_name_y',\n    'calaccess_filing_id', 'date_received', 'contributor_lastname', 'contributor_firstname',\n    'contributor_city', 'contributor_state', 'contributor_zip', 'contributor_employer',\n    'contributor_occupation', 'contributor_is_self_employed', 'amount'\n]\n\n# Select and reorder columns to match the target schema exactly\ndf_result = df_joined[target_columns]\n\n# Ensure data types match target schema\n\n# 'ocd_prop_id': string\ndf_result['ocd_prop_id'] = df_result['ocd_prop_id'].astype(str)\n\n# Integer columns\nint_cols = ['calaccess_prop_id', 'ccdc_prop_id', 'ccdc_committee_id', 'calaccess_committee_id', 'calaccess_filing_id']\nfor col in int_cols:\n    df_result[col] = pd.to_numeric(df_result[col], errors='coerce').fillna(0).astype(int)\n\n# String columns\nstr_cols = [\n    'prop_name', 'committee_name_x', 'committee_position', 'committee_name_y', 'date_received',\n    'contributor_lastname', 'contributor_firstname', 'contributor_city', 'contributor_state',\n    'contributor_zip', 'contributor_employer', 'contributor_occupation'\n]\nfor col in str_cols:\n    df_result[col] = df_result[col].astype(str)\n\n# Boolean column\ndf_result['contributor_is_self_employed'] = df_result['contributor_is_self_employed'].astype(bool)\n\n# Float column\ndf_result['amount'] = pd.to_numeric(df_result['amount'], errors='coerce').fillna(0.0).astype(float)\n\n# Write the result to the specified output path\noutput_path = \"autopipeline-benchmarks/github-pipelines/length1_56/target_multisource.csv\"\ndf_result.to_csv(output_path, index=False)",
