nsure data types match target schema\n\n    # 'ocd_prop_id': string\n    df_result['ocd_prop_id'] = df_result['ocd_prop_id'].astype(str)\n\n    # Integer columns\n    int_cols = ['calaccess_prop_id', 'ccdc_prop_id', 'ccdc_committee_id', 'calaccess_committee_id', 'calaccess_filing_id']\n    for col in int_cols:\n        df_result[col] = pd.to_numeric(df_result[col], errors='coerce').fillna(0).astype(int)\n\n    # String columns\n    str_cols = [\n        'prop_name', 'committee_name_x', 'committee_position', 'committee_name_y', 'date_received',\n        'contributor_lastname', 'contributor_firstname', 'contributor_city', 'contributor_state',\n        'contributor_zip', 'contributor_employer', 'contributor_occupation'\n    ]\n    for col in str_cols:\n        df_result[col] = df_result[col].astype(str)\n\n    # Boolean column\n    # Some values might be non-boolean or missing, so coerce carefully\n    df_result['contributor_is_self_employed'] = df_result['contributor_is_self_employed'].map(\n        {True: True, False: False, 'True': True, 'False': False, 1: True, 0: False}\n    )\n    # Fill missing with False (assuming default)\n    df_result['contributor_is_self_employed'] = df_result['contributor_is_self_employed'].fillna(False).astype(bool)\n\n    # Float column\n    df_result['amount'] = pd.to_numeric(df_result['amount'], errors='coerce').fillna(0.0).astype(float)\n\n    # Write the result to the specified output path\n    output_path = \"autopipeline-benchmarks/github-pipelines/length1_56/target_multisource.csv\"\n    df_result.to_csv(output_path, index=False)\n\nif __name__ == \"__main__\":\n    main()",
