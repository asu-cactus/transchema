        "code": "import pandas as pd\n\n# Paths to source CSV files\nsource0_path = \"autopipeline-benchmarks/github-pipelines/length1_56/test_0.csv\"\nsource1_path = \"autopipeline-benchmarks/github-pipelines/length1_56/test_1.csv\"\n\n# Load source tables with index_col=0 to ignore the numerical index column\ndf0 = pd.read_csv(source0_path, index_col=0)\ndf1 = pd.read_csv(source1_path, index_col=0)\n\n# Rename columns in df1 to avoid collision after join for committee_name columns\n# df1 has 'committee_name' and 'committee_position'\n# df0 has 'committee_name' as well\n# After join, we want to keep both committee_name columns distinctly as committee_name_x and committee_name_y\n# pandas.merge with suffixes will handle this automatically\n\n# Join df1 and df0 on 'calaccess_committee_id'\n# This is the only shared key column between the two sources\ndf_joined = pd.merge(df1, df0, on='calaccess_committee_id', how='inner', suffixes=('_x', '_y'))\n\n# Target schema columns in order:\ntarget_columns = [\n    'ocd_prop_id', 'calaccess_prop_id', 'ccdc_prop_id', 'prop_name', 'ccdc_committee_id',\n    'calaccess_committee_id', 'committee_name_x', 'committee_position', 'committee_name_y',\n    'calaccess_filing_id', 'date_received', 'contributor_lastname', 'contributor_firstname',\n    'contributor_city', 'contributor_state', 'contributor_zip', 'contributor_employer',\n    'contributor_occupation', 'contributor_is_self_employed', 'amount'\n]\n\n# Select and reorder columns to match the target schema exactly\ndf_result = df_joined[target_columns]\n\n# Ensure data types match target schema (optional but recommended)\n# According to target schema:\n# 'ocd_prop_id': string\ndf_result['ocd_prop_id'] = df_result['ocd_prop_id'].astype(str)\n# 'calaccess_prop_id', 'ccdc_prop_id', 'ccdc_committee_id', 'calaccess_committee_id', 'calaccess_filing_id': integer\nint_cols = ['calaccess_prop_id', 'ccdc_prop_id', 'ccdc_committee_id', 'calaccess_committee_id', 'calaccess_filing_id']\nfor col