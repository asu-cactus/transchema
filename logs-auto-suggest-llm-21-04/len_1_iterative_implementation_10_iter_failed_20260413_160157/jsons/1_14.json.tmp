        "code": "import pandas as pd\n\n# Load source tables with index_col=0 to ignore the numerical index column\nsource0_path = \"autopipeline-benchmarks/github-pipelines/length1_14/test_0.csv\"\nsource1_path = \"autopipeline-benchmarks/github-pipelines/length1_14/test_1.csv\"\n\ndf_source0 = pd.read_csv(source0_path, index_col=0)\ndf_source1 = pd.read_csv(source1_path, index_col=0)\n\n# According to operation_history: JOIN : [[\"Source1_14_0\", \"Source1_14_1\"], [\"PLAYER\", \"Player\"]]\n# Join df_source0 and df_source1 on df_source0.PLAYER == df_source1.Player\n\n# Perform inner join to keep only matching players\ndf_joined = pd.merge(df_source0, df_source1, left_on=\"PLAYER\", right_on=\"Player\", how=\"inner\")\n\n# Target schema:\n# ['PLAYER': string, '2017-18': integer, '#': integer, 'Player': string, 'Team': string, 'GP': integer,\n#  'MPG': float, 'FGM': float, 'FGA': float, 'FG%': float, '3PM': float, '3PA': float, '3P%': float,\n#  'FTM': float, 'FTA': float, 'FT%': float, 'TOV': float, 'PF': float, 'ORB': float, 'DRB': float,\n#  'RPG': float, 'APG': float, 'SPG': float, 'BPG': float, 'PPG': float]\n\n# Ensure correct dtypes according to target schema\n# PLAYER: string (from source0)\ndf_joined[\"PLAYER\"] = df_joined[\"PLAYER\"].astype(str)\n\n# 2017-18: integer (from source0)\ndf_joined[\"2017-18\"] = pd.to_numeric(df_joined[\"2017-18\"], errors='coerce').fillna(0).astype(int)\n\n# '#': integer (from source1)\ndf_joined[\"#\"] = pd.to_numeric(df_joined[\"#\"], errors='coerce').fillna(0).astype(int)\n\n# Player: string (from source1)\ndf_joined[\"Player\"] = df_joined[\"Player\"].astype(str)\n\n# Team: string\ndf_joined[\"Team\"] = df_joined[\"Team\"].astype(str)\n\n# GP: integer\ndf_joined[\"GP\"] = pd.to_numeric(df_joined[\"GP\"], errors='coerce').fillna(0).astype(int)\n\n# MPG: float\ndf_joined[\"MPG\"] = pd.to_numeric(df_joined[\"MPG\"], errors='coerce').astype(float)\n\n# FGM: float\ndf_joined[\"FGM\"] = pd.to_numeric(df_joined[\"FGM\"], errors